rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to verify staff access
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admins registry: only authenticated admins can inspect
    match /admins/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Provisioned directly in Firebase console
    }

    // Public tracking allows guests to read their own status and create new ones
    match /publicTracking/{reference} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Guest submissions (Open for creation, locked for everything else)
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /roomServiceOrders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /restaurantReservations/{resId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /eventInquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /newsletterSubscribers/{subId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Public Catalogs (Viewable by everyone, editable by admins)
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /foods/{foodId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}