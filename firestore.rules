rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function validText(value, max) { return value is string && value.size() > 0 && value.size() <= max; }
    match /admins/{id} {
      allow read: if signedIn() && request.auth.uid == id;
      allow write: if admin();
    }
    match /rooms/{id} { allow read: if true; allow write: if admin(); }
    match /bookings/{id} { allow create: if validText(request.resource.data.email, 254) && validText(request.resource.data.firstName, 80) && request.resource.data.status == 'pending'; allow read, update, delete: if admin(); }
    match /restaurantReservations/{id} { allow create: if validText(request.resource.data.email, 254) && validText(request.resource.data.name, 120) && request.resource.data.status == 'pending'; allow read, update, delete: if admin(); }
    match /roomServiceOrders/{id} { allow create: if validText(request.resource.data.name, 120) && validText(request.resource.data.roomNumber, 30) && request.resource.data.status == 'pending'; allow read, update, delete: if admin(); }
    match /eventInquiries/{id} { allow create: if validText(request.resource.data.email, 254) && validText(request.resource.data.name, 120) && request.resource.data.status == 'new'; allow read, update, delete: if admin(); }
    match /messages/{id} { allow create: if validText(request.resource.data.email, 254) && validText(request.resource.data.message, 2000) && request.resource.data.status == 'new'; allow read, update, delete: if admin(); }
    match /newsletterSubscribers/{id} { allow create: if validText(request.resource.data.email, 254) && request.resource.data.status == 'active'; allow read, update, delete: if admin(); }
  }
}
